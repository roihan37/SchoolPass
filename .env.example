# Salin ke .env dan isi password lokal sebelum menjalankan Compose.
POSTGRES_DB=schoolpass
POSTGRES_USER=schoolpass
POSTGRES_PASSWORD=
# API/Prisma membaca .env root, membentuk URL lokal dari POSTGRES_* di atas.
# Opsional: override untuk host/port database yang berbeda. Jangan isi kredensial nyata.
# DATABASE_URL=
# TEST_DATABASE_URL= (nama database terpisah wajib berakhiran _test)
# Diperlukan untuk seed; minimal 16 karakter. Seed ulang tidak mereset password.
SEED_PASSWORD=
# Secret acak lokal minimal 32 byte; jangan commit nilainya. Lihat README.
JWT_SECRET=
