generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PARENT
  TEACHER
}

enum LeaveType {
  SICK
  PERMISSION
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  LEAVE_DECIDED
}

model User {
  id              String         @id @default(uuid()) @db.Uuid
  name            String
  email           String         @unique
  passwordHash    String
  role            Role
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  classes         SchoolClass[]
  children        Student[]
  submittedLeaves LeaveRequest[] @relation("SubmittedLeaves")
  reviewedLeaves  LeaveRequest[] @relation("ReviewedLeaves")
  notifications   Notification[]
}

model SchoolClass {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  teacherId String    @db.Uuid
  teacher   User      @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  students  Student[]
  joinCodeHash String? @unique

  @@unique([teacherId, name])
  @@index([teacherId])
}

model Student {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  parentId      String         @db.Uuid
  classId       String         @db.Uuid
  parent        User           @relation(fields: [parentId], references: [id], onDelete: Restrict)
  schoolClass   SchoolClass    @relation(fields: [classId], references: [id], onDelete: Restrict)
  leaveRequests LeaveRequest[]

  @@index([parentId])
  @@index([classId])
}

model LeaveRequest {
  id             String         @id @default(uuid()) @db.Uuid
  studentId      String         @db.Uuid
  submittedById  String         @db.Uuid
  absenceDate    DateTime       @db.Date
  type           LeaveType
  reason         String
  status         LeaveStatus    @default(PENDING)
  reviewedById   String?        @db.Uuid
  decisionReason String?
  reviewedAt     DateTime?      @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  student        Student        @relation(fields: [studentId], references: [id], onDelete: Restrict)
  submittedBy    User           @relation("SubmittedLeaves", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedBy     User?          @relation("ReviewedLeaves", fields: [reviewedById], references: [id], onDelete: Restrict)
  attachment     Attachment?
  notifications  Notification[]

  @@unique([studentId, absenceDate])
  @@index([status, createdAt])
}

model Attachment {
  id             String       @id @default(uuid()) @db.Uuid
  leaveRequestId String       @unique @db.Uuid
  objectKey      String       @unique
  fileName       String
  mimeType       String
  fileSize       Int
  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Restrict)
}

model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  leaveRequestId String           @db.Uuid
  type           NotificationType
  message        String
  readAt         DateTime?        @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  leaveRequest   LeaveRequest     @relation(fields: [leaveRequestId], references: [id], onDelete: Restrict)

  @@unique([userId, leaveRequestId, type])
  @@index([userId, createdAt])
}
